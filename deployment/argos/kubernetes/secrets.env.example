# =============================================================================
# Argos — secrets (trois Secrets Kubernetes, un par composant).
# Copier ce fichier, le compléter, puis :
#   kubectl -n argos create secret generic argos-secrets --from-env-file=argos-secrets.env
#   kubectl -n argos create secret generic odin-secrets  --from-env-file=odin-secrets.env
#   kubectl -n argos create secret generic zeus-secrets  --from-env-file=zeus-secrets.env
# Ne jamais versionner les fichiers complétés.
# =============================================================================

# ---- argos-secrets.env ----------------------------------------------------------
DATABASE_URL=postgresql://argos:CHANGE_ME@postgres.example.com:5432/argos
# 32 caractères minimum (openssl rand -base64 48) ; à SAUVEGARDER
ENCRYPTION_KEY=CHANGE_ME
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
DEVANA_CLIENT_ID=CHANGE_ME
DEVANA_CLIENT_SECRET=CHANGE_ME

# ---- odin-secrets.env -------------------------------------------------------------
# DATABASE_URL=postgresql://argos:CHANGE_ME@postgres.example.com:5432/odin
# S3_ACCESS_KEY=CHANGE_ME
# S3_SECRET_KEY=CHANGE_ME

# ---- zeus-secrets.env -------------------------------------------------------------
# S3_ACCESS_KEY=CHANGE_ME
# S3_SECRET_KEY=CHANGE_ME
# LLM_VISION_API_KEY=CHANGE_ME
