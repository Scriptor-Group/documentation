# =============================================================================
# Argos — configuration de l'installation Docker Compose
#   cp env.example .env && chmod 600 .env
# Les valeurs sans défaut sont obligatoires : le démarrage échoue tant qu'elles
# ne sont pas renseignées.
# =============================================================================

# --- Accès -------------------------------------------------------------------
# URL du dashboard telle que la voient les utilisateurs (port publié ou reverse
# proxy HTTPS). Sert au retour de connexion et à l'adresse MCP affichée.
PUBLIC_URL=http://argos.example.com:3100

# --- Connexion au dashboard (OAuth Devana) -----------------------------------
# URL de l'API de votre plateforme Devana et client OAuth créé pour Argos
# (URI de redirection : <PUBLIC_URL>/auth/callback).
DEVANA_API_URL=https://api.devana.example.com
DEVANA_CLIENT_ID=
DEVANA_CLIENT_SECRET=
# Emails promus administrateurs à la première connexion (séparés par des
# virgules). Vide : le premier utilisateur connecté devient administrateur.
BOOTSTRAP_ADMIN_EMAILS=

# --- Secrets de la pile --------------------------------------------------------
# Chiffrement des secrets stockés (mots de passe SharePoint, keytabs, clés LLM) :
# 32 caractères minimum, à SAUVEGARDER (sans elle, ils sont illisibles).
#   openssl rand -base64 48
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
# MINIO_ROOT_USER=argos
# S3_BUCKET=argos

# --- Extraction (Zeus) : modèle de vision ------------------------------------
# API compatible OpenAI. Sans clé, les documents textuels sont traités ; seules
# les pages scannées et les images restent sans description.
LLM_VISION_API_URL=https://api.openai.com/v1
LLM_VISION_API_KEY=
LLM_VISION_MODEL=gpt-4.1-mini

# --- Versions des images -------------------------------------------------------
# ARGOS_VERSION=latest                              # ex. 1.0.0
# ODIN_IMAGE=registry.devana.ai/devana/odin:latest
# ZEUS_IMAGE=registry.devana.ai/devana/zeus:latest
# REGISTRY=registry.devana.ai/devana                 # ou votre registre miroir

# --- Ports ---------------------------------------------------------------------
# FRONT_PORT=3100
# PUBLISH_ADDR=127.0.0.1        # adresse des ports d'administration (API, Postgres, console MinIO)
# API_PORT=4000
# POSTGRES_PORT=5432
# MINIO_CONSOLE_PORT=9001

# --- Réglages avancés -----------------------------------------------------------
# LOG_LEVEL=info
# ODIN_CONCURRENCY=24           # ≥ total des slots Odin (Paramètres › Traitement)
# ZEUS_CONCURRENCY=4
# ZEUS_TESSERACT_LANG=fra+eng
